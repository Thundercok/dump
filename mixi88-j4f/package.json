{
  "name": "saigonride-taixiu",
  "version": "1.0.0",
  "description": "SaigonRide Tài Xỉu – Fake Gambling Demo (MVC)",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "jest --forceExit --runInBand",
    "test:coverage": "jest --coverage --forceExit --runInBand"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "moment": "^2.30.1",
    "morgan": "^1.10.0",
    "qs": "^6.12.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"],
    "collectCoverageFrom": [
      "models/**/*.js",
      "controllers/**/*.js",
      "utils/**/*.js"
    ]
  }
}
