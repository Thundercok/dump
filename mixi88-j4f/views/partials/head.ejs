</div>

<nav class="navbar navbar-dark sr-navbar px-3">
  <div class="d-flex align-items-center gap-2">
    <span class="sr-logo-flame">🦊</span>
    <div>
      <div class="sr-logo-text">MIXI88</div>
      <div class="sr-logo-sub">Tài Xỉu · VIP Edition</div>
