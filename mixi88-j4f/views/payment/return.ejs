<%
  activeTab = 'deposit';
%>
<%- include('../partials/head') %>

<div class="row justify-content-center">
  <div class="col-md-6 col-lg-5">
    <div class="sr-panel text-center py-4">
      <% if (success) { %>
        <div style="font-size:64px" class="mb-3">🎉</div>
        <h4 class="text-warning fw-bold mb-2" style="font-family:'Press Start 2P',monospace;font-size:18px">
          NẠP THÀNH CÔNG!
        </h4>
        <p class="text-success fw-bold fs-5 mb-1"><%= message %></p>
        <% if (tx) { %>
        <div class="sr-bet-display text-start mt-3 mb-3">
          <div class="d-flex justify-content-between mb-1">
            <span class="text-muted" style="font-size:12px">Order ID:</span>
            <span style="font-size:12px"><%= tx.orderId %></span>
          </div>
          <div class="d-flex justify-content-between mb-1">
            <span class="text-muted" style="font-size:12px">Số tiền:</span>
            <span class="text-warning fw-bold"><%= tx.amount.toLocaleString('vi-VN') %> ₫</span>
          </div>
          <div class="d-flex justify-content-between">
            <span class="text-muted" style="font-size:12px">Trạng thái:</span>
            <span class="badge bg-success">✓ Thành công</span>
          </div>
        </div>
        <% } %>
        <a href="/game" class="sr-roll-btn d-block text-decoration-none">
          <i class="bi bi-dice-5-fill me-2"></i>CHƠI NGAY
        </a>
      <% } else { %>
        <div style="font-size:64px" class="mb-3">😔</div>
        <h4 class="text-danger fw-bold mb-2" style="font-family:'Press Start 2P',monospace;font-size:16px">
          THANH TOÁN THẤT BẠI
        </h4>
        <p class="text-muted mb-3"><%= message %></p>
        <a href="/payment/deposit" class="sr-roll-btn d-block text-decoration-none">
          <i class="bi bi-arrow-counterclockwise me-2"></i>THỬ LẠI
        </a>
      <% } %>
      <div class="mt-3">
        <a href="/game" class="text-muted" style="font-size:12px">← Quay lại trò chơi</a>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/foot') %>
