@page
@model WindowsFormApp.Pages.CoursesModel
@{
    ViewData["Title"] = "Manage Courses";
}

<h2>Course Management</h2>

<div style="margin-bottom: 20px; padding: 15px; border: 1px solid #ccc; border-radius: 5px;">
    <h4>Add New Course</h4>
    <form method="post" asp-page-handler="Add">
        <div style="margin-bottom: 10px;">
            <label>Course Name:</label><br />
            <input type="text" name="CourseName" required style="width: 300px;" />
        </div>
        <div style="margin-bottom: 10px;">
            <label>Credits:</label><br />
            <input type="number" name="Credits" required style="width: 100px;" />
        </div>
        <button type="submit">Add Course</button>
    </form>
</div>

<table border="1" cellpadding="10" style="width: 100%; border-collapse: collapse; text-align: left;">
    <thead>
    <tr style="background-color: #f2f2f2;">
        <th>ID</th>
        <th>Course Name</th>
        <th>Credits</th>
        <th>Action</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var row in Model.CourseList)
    {
        <tr>
            <td>@row["CourseID"]</td>
            <td>@row["CourseName"]</td>
            <td>@row["Credits"]</td>
            <td>
                <form method="post" asp-page-handler="Delete" style="display:inline;">
                    <input type="hidden" name="CourseID" value="@row["CourseID"]" />
                    <button type="submit" onclick="return confirm('Are you sure you want to delete this course?');">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>

