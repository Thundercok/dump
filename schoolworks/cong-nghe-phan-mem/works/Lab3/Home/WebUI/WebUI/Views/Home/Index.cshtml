@model IEnumerable<DAL.Models.Student>

<h2>Student Directory</h2>
<a href="/Student/Create" class="btn btn-primary mb-3">Add New Student</a>

<table class="table table-bordered">
    <thead>
    <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Email</th>
        <th>Major</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.FullName</td>
            <td>@item.Email</td>
            <td>@item.Major</td>
        </tr>
    }
    </tbody>
</table>