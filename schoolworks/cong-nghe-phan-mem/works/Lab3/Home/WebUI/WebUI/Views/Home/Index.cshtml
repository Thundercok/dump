@model IEnumerable<DAL.Models.Student>

@if (Model != null && Model.Any())
{
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Id</td>
            <td>@item.FullName</td>
            <td>@item.Email</td>
            <td>@item.Major</td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="4" class="text-center">No data available right now.</td>
    </tr>
}